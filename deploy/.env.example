# Copia este archivo a deploy/.env y completa los valores. deploy/.env NO va a git.
# Guía completa: docs/dev/despliegue-vps.md

# --- Dominio y HTTPS (Caddy obtiene el certificado solo) ---
DOMAIN=dossier.midominio.com
ACME_EMAIL=admin@midominio.com

# --- PostgreSQL (contenedor del compose) ---
POSTGRES_DB=sistemadossier
POSTGRES_USER=dossier
# Genera una larga: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Seguridad de la API ---
# Genera uno largo: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Proveedores ---
DEEPSEEK_API_KEY=
PDL_API_KEY=
COMPANIES_HOUSE_API_KEY=
NEWS_API_KEY=

# --- Calendarios (OAuth) ---
# Registra estas URIs en Google Cloud y en Azure, con tu dominio real:
#   https://DOMAIN/api/callback-google   y   https://DOMAIN/api/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dossier.midominio.com/api/callback-google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://dossier.midominio.com/api/callback

# --- Créditos ---
DOSSIER_CHARGE_CREDITS=1
