# Copia este archivo a `.env` en backend/ y rellena los valores.
# Nunca subas `.env` al repositorio.

# --- Base de datos (obligatorio para el dashboard) ---
# Opción A: URL completa (Neon, Render, local…)
DATABASE_URL=
# Opción B: componentes sueltos (si no usas DATABASE_URL)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=sistemadossier
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10

# Pruebas contra Postgres real (tests/integration y tests/security de S4.5):
# NO va en este archivo. Defínela en la terminal antes de correr pytest, porque
# las pruebas no cargan .env a propósito (ver tests/conftest.py). Base aparte y
# desechable: la prueba BORRA su esquema, así que el nombre debe contener "test".
# Sin la variable, esas pruebas se saltan.
#   $env:TEST_DATABASE_URL="postgresql://postgres:clave@localhost:5432/dossier_test"
DATABASE_AUTO_CREATE_TABLES=0

# --- Auth JWT (obligatorio) ---
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS y URLs del frontend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_VERCEL_APP_REGEX=1
# CORS_VERCEL_ORIGIN_REGEX=
FRONTEND_URL=http://localhost:3000
# DOSSIER_FRONTEND_URL=

# --- IA / dossiers (API principal: DeepSeek) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TEXT_TIMEOUT_SEC=120
# DEEPSEEK_DISABLE_PERSON_WEB=0
# DEEPSEEK_PERSON_WEB_ALWAYS=0
# DEEPSEEK_PERSON_MAX_JSON_CHARS=120000

# Gemini / Google (CLIs SEC y Companies House; fallback opcional)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_UPLOAD_BYTES=800000
# GEMINI_SKIP_ANALYSIS=0
# OPENAI_API_KEY=

# --- Registros corporativos ---
COMPANIES_HOUSE_API_KEY=
# DOSSIER_CORPORATE_SEC_FILING_GEMINI=1
# DOSSIER_CORPORATE_CH_FILING_GEMINI=1
# DOSSIER_SEC_COMPANY_FACTS=1

# --- Investigación de personas (People Data Labs) ---
PDL_API_KEY=
# PEOPLE_DATA_LABS_API_KEY=
# PDL_API_URL=
# PDL_MIN_LIKELIHOOD=2
PERSON_RESEARCH_PROVIDER=pdl

# --- OAuth Microsoft (Outlook / Graph) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/callback
# MICROSOFT_REDIRECT_URL=
# MICROSOFT_OAUTH_SUCCESS_URL=

# --- OAuth Google (Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/callback-google
# GOOGLE_REDIRECT_URL=

# --- Créditos y planes ---
DOSSIER_CHARGE_CREDITS=true
ORG_SIGNUP_CREDITS=10
ORG_SIGNUP_CREDITS_MONTHLY_LIMIT=10

# --- Redis (caché dossiers; opcional) ---
# REDIS_URL=
DOSSIER_REDIS_ENABLED=1
# DOSSIER_REDIS_TTL_SECONDS=86400
# DOSSIER_PERSON_CACHE_VERSION=1
# DOSSIER_CACHE_PIPELINE_VERSION=1

# --- Workers en background ---
DOSSIER_GENERATION_WORKER_ENABLED=1
DOSSIER_GENERATION_POLL_SECONDS=2
DOSSIER_RETENTION_WORKER_ENABLED=1
DOSSIER_RETENTION_POLL_SECONDS=3600
CALENDAR_AUTOMATION_ENABLED=1
CALENDAR_AUTOMATION_POLL_SECONDS=60
CALENDAR_DEFAULT_ADVANCE_MINUTES=20

